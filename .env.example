# Local Node timezone. Vercel reserves the name `TZ` (always UTC), so the
# deployment reads APP_TZ instead — see src/instrumentation.ts.
TZ=Asia/Ho_Chi_Minh
APP_TZ=
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Phone is the UI username. "email" uses a non-deliverable synthetic email
# because Supabase phone auth requires an SMS provider even when confirmations
# are disabled. "phone" uses native phone + password (requires Twilio config).
AUTH_IDENTIFIER_MODE=email
AUTH_PHONE_EMAIL_DOMAIN=phone.chotkeo.invalid

# Cloudflare Turnstile (free). Leave empty for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
