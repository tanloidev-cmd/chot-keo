{
  "name": "chot-keo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env TZ=Asia/Ho_Chi_Minh next dev",
    "build": "cross-env TZ=Asia/Ho_Chi_Minh next build",
    "start": "cross-env TZ=Asia/Ho_Chi_Minh next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:validate": "node scripts/validate-sql.mjs",
    "test:rls": "node scripts/validate-sql.mjs && node scripts/test-rls.mjs",
    "test:e2e": "playwright test",
    "seed:demo": "node scripts/seed-demo.mjs",
    "admin:reset": "node scripts/admin-reset-password.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
